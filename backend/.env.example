OPENAI_API_KEY=sua_chave_openai_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui

# Transcricao: provedor e modelo
# Provedor de transcricao: "groq" (padrao, mais rapido e barato) ou "openai"
TRANSCRICAO_PROVIDER=groq
# Groq: whisper-large-v3-turbo (recomendado, R$0,0004/min) ou whisper-large-v3 (mais preciso)
# OpenAI: gpt-4o-mini-transcribe, gpt-transcribe
TRANSCRICAO_MODEL=whisper-large-v3-turbo
# Chave da API Groq (gratuita em https://console.groq.com/keys)
GROQ_API_KEY=sua_chave_groq_aqui

# Provedor de IA para síntese clínica: "gemini" (padrao, rapido), "openai" ou "deepseek"
IA_MODEL_PROVIDER=gemini

# Modelo específico do provedor (apenas OpenAI usa IA_MODEL; Gemini usa GEMINI_MODEL
# e DeepSeek usa deepseek-v4-flash internamente)
# OpenAI: gpt-4.1, gpt-4o, gpt-4o-mini, etc.
# DeepSeek: deepseek-v4-flash
# Gemini: gemini-3.7-flash (padrao; configure GEMINI_MODEL para trocar sem redeploy)
IA_MODEL=gpt-4.1
GEMINI_MODEL=gemini-3.7-flash

HOST=0.0.0.0
PORT=8000

# Autenticação JWT
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
APP_USERNAME=admin
APP_PASSWORD_HASH=substitua_pelo_hash_bcrypt
# Identificador fixo do proprietario dos dados (isolamento owner_id). Gere um UUID
# e mantenha-o estavel entre os deploys. Se ausente, um novo UUID e gerado a cada
# restart, orfanando contratos/anamneses/lembretes ja criados.
APP_USER_ID=substitua_por_um_uuid_fixo

# OpenAlex (busca de artigos): key gratuita em https://openalex.org/settings/api ($1/dia de uso)
OPENALEX_API_KEY=sua_chave_openalex_aqui
# Email para o polite pool da OpenAlex
OPENALEX_MAILTO=seu_email@exemplo.com

# Turso (banco de dados SQLite na edge — gratuito em https://turso.tech)
# Crie um banco e obtenha a URL e o token em https://console.turso.org
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=seu_token_turso_aqui

# URL publica do backend, usada para gerar os links de contrato/anamnese enviados ao paciente
API_BASE_URL=https://mentall-api.fly.dev

# SMTP para envio de emails (recuperacao de PIN e confirmacao de cadastro)
# Gmail exige uma "Senha de app" (nao a senha normal): Google Account > Seguranca > Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com

# Wuzapi (envio de lembretes de sessao via WhatsApp do proprio profissional)
# URL do servico wuzapi. Local: http://localhost:8080 ; Producao: URL do app no Fly.io
WUZAPI_BASE_URL=http://localhost:8080
# Token do usuario wuzapi conectado (usado no primeiro momento, instancia unica).
# Com varios profissionais, cada um registra o proprio token via POST /wuzapi/config
WUZAPI_TOKEN=seu_token_wuzapi_aqui

# Token que autentica o webhook de entrega/leitura enviado pelo wuzapi ao backend.
# A URL do webhook no wuzapi deve incluir este token: POST /webhook com
# webhookurl=http://localhost:8000/wuzapi/webhook?token=<WUZAPI_WEBHOOK_TOKEN>
WUZAPI_WEBHOOK_TOKEN=gerar_com_python_secrets_token_urlsafe

# Janela de retry de lembretes (minutos) apos o horario previsto de envio.
# Se o WhatsApp/wuzapi estiver fora do ar no horario, o scheduler continua tentando
# durante essa janela antes de marcar o lembrete como 'falha'. Padrao: 60.
JANELA_RETRY_LEMBRETES_MINUTOS=60

# Watchdog de reconexao do wuzapi: intervalo minimo (segundos) entre tentativas
# de reconexao automatica quando o WhatsApp cai. Padrao: 300 (5 min).
WUZAPI_RECONNECT_COOLDOWN_SECONDS=300
